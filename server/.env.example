TMDB_API_KEY=your_tmdb_api_key_here
GROQ_API_KEY=your_groq_api_key_here
DDD_API_KEY=your_ddd_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
PORT=5000
# Restrict CORS to your deployed frontend (comma-separated). Unset = any origin, with a startup warning.
FRONTEND_URL=https://your-app.vercel.app
# Data lives in Firestore (same Firebase project as auth). Optional: namespace
# top-level collections, e.g. for a staging environment sharing the project.
# FIRESTORE_PREFIX=staging_
# Optional: enables GET /api/admin/metrics (send as X-Admin-Token). Use a long random value.
# ADMIN_TOKEN=
