rules_version = '2';
// ClearWatch never reads or writes Firestore from the browser or the app —
// only the server does, through the Admin SDK (which bypasses these rules).
// So deny all client access: user sensitivity data must never be reachable
// with just the public Firebase web config.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
